---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompositionControls from '../components/CompositionControls.astro';
import Solo from '../components/composizioni/Solo.astro';
import Trio from '../components/composizioni/Trio.astro';
import Psicogeografico from '../components/composizioni/Psicogeografico.astro';
import hero from '../assets/composizioni/ecatorf-hero.webp';
import '../styles/composizioni.css';

const widths = [320, 480, 768, 1280, 1920].filter(width => width < hero.width).concat(hero.width);
---

<BaseLayout title="Sergio Fedele – Composizioni e CD"
            socialImage={hero}
            socialImageAlt="Dettaglio del corpo centrale dell’Ecatorf"
            description="Le composizioni di Sergio Fedele: Ecatorf solo, Ecatorf Trio e PsicoGeografico Ensemble. Partiture, presentazioni, CD e recensioni.">

    <header class="compositions-hero">
        <Image src={hero} widths={widths} sizes="100vw" alt="" format="webp" quality={90} priority/>
        <h1 class="page-title">
            Composizioni e CD
        </h1>
    </header>

    <div class="compositions">
        <Solo/>
        <Trio/>
        <Psicogeografico/>
    </div>

</BaseLayout>

<CompositionControls/>
