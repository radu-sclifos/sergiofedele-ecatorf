---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignCarousel from '../components/DesignCarousel.astro';
import { designPages } from '../data/ecatorf-design';
import hero from '../assets/ecatorf/numa-schio.webp';
import detail from '../assets/ecatorf/dettaglio-ecatorf.webp';
import instrument from '../assets/ecatorf/ecatorf.webp';

const images = import.meta.glob<ImageMetadata>('../assets/ecatorf/*.webp', {eager: true, import: 'default'});
const scores = Object.fromEntries(Object.entries(images).map(([path, image]) => [path.slice(path.lastIndexOf('/') + 1), image]));
const widths = (image: ImageMetadata) => [320, 480, 768, 1280, 1920].filter(width => width < image.width).concat(image.width);
---

<BaseLayout title="Sergio Fedele – Ecatorf"
            description="Ecatorf: aerofono ad ancia semplice e tubo cilindrico, uno degli strumenti musicali più bassi al mondo.">
    <header class="hero">
        <Image src={hero} widths={widths(hero)} sizes="100vw" alt="" priority/>
        <h1 class="page-title">Ecatorf</h1>
    </header>
    <article class="ecatorf" aria-label="Ecatorf">
        <div class="structure">
            <div class="structure-heading">
                <h2>
                    <span data-language="it">Struttura</span>
                    <span data-language="en" lang="en" hidden>Structure</span>
                </h2>
                <button class="translation" type="button" hidden aria-label="Read in English" aria-pressed="false">
                    Translation
                </button>
            </div>
            <div class="body-copy" data-language="it">
                <p>
                    <b>Classificazione:</b><br>
                    Lo strumento, di metallo, è un aerofono ad ancia semplice e tubo cilindrico.
                </p>
                <p>
                    <b>Sistema combinato di articolazione e suddivisione del canneggio:</b><br>
                    Le modificazioni della lunghezza del tubo, che consentono il mutamento di frequenza,
                    sono date da una coulisse e da 3 cilindri a valvola regolati da chiavi che consentono di
                    accorciare o allungare il condotto acustico. Gli armonici sono prodotti da 4 portavoce
                    muniti di altrettante chiavi.
                </p>
                <p>
                    <b>Imboccatura:</b><br>
                    Il bocchino utilizzato è quello del clarinetto contrabbasso.
                </p>
                <p>
                    <b>Coulisse:</b><br>
                    La coulisse è doppia e fa scorrere contemporaneamente quattro tubi anziché due, essa
                    consente di aumentare la parte mobile dello strumento rispetto a quella fissa.
                </p>
            </div>
            <div class="body-copy" data-language="en" lang="en" hidden>
                <p>
                    <b>Classification:</b><br>
                    The instrument, made in metal, is a single reed and cylindrical tube aerophone.
                </p>
                <p>
                    <b>Combined system of tubing articulation and subdivision:</b><br>
                    The changes in the length of the tube, that allow the variation of frequency, are
                    given by the slide and three rotary valves. The harmonics are generated by four
                    speaker keys.
                </p>
                <p>
                    <b>Embouchure:</b><br>
                    The used mouthpiece is the contrabass clarinet one.
                </p>
                <p>
                    <b>Slide:</b><br>
                    The coulisse is double and it makes sliding four tubes rather than two. It permits
                    to increase the moving part of the instrument.
                </p>
            </div>
        </div>
        <div class="right-column">
            <div class="instrument-photo photo">
                <Image src={instrument} widths={widths(instrument)} sizes="(max-width: 48rem) 100vw, 510px"
                       alt="Vista laterale dell’Ecatorf e delle sue tre campane" loading="lazy" decoding="async"/>
            </div>
            <div class="technical-description">
                <div class="body-copy" data-language="it">
                    <p>
                        <b>Valvole e campane:</b><br>
                        3 valvole producono la divisione del tubo in 4 diversi ambiti di lunghezza e quindi di
                        frequenza. Il tragitto dell’onda sonora viene accorciato da due diverse valvole centrali
                        e viene invece allungato da una terza finale che accede ad un tubo ausiliario.
                        Le due prime valvole, ciascuna accedente ad una diversa campana, dividono il tubo a
                        circa la metà della sua lunghezza e sono collocate in mezzo alla doppia coulisse. Dal
                        cilindro della valvola 1 esce direttamente una piccola campana, dalla valvola 2 esce un
                        tubo ausiliario con una campana più grande. A queste due prime posizioni dello
                        strumento, segue la posizione normale, rappresentata dall’intero percorso del tubo lungo
                        la doppia coulisse e accedente ad un’ultima grande campana finale. La valvola 3,
                        collocata prima dell’ultima campana, approda ad un lungo tubo ausiliario che sbocca
                        nella suddetta campana. I tubi ausiliari e la parte finale del tubo principale che
                        precede l’ultima campana sono muniti di pompa di intonazione.<br>
                        3 chiavi azionate dalla mano sinistra consentono il movimento delle valvole.
                    </p>
                    <p>
                        <b>Posizioni:</b><br>
                        Lo strumento ha, perciò, 4 posizioni fisse, ognuna delle quali consente un certo numero
                        di escursioni cromatiche della coulisse (qui sotto le posizioni relative ai
                        fondamentali).<br>
                        Valvola 1 : 10 posizioni (2 a coulisse chiusa più 8 escursioni).<br>
                        Valvola 2 : 6 posizioni (coulisse chiusa più 5 escursioni).<br>
                        Normale : 8 posizioni (coulisse chiusa più 7 escursioni).<br>
                        Valvola 3 : 6 posizioni (coulisse chiusa più 5 escursioni) più 3 posizioni con pompa di
                        intonazione.
                    </p>
                    <p>
                        <b>Sistema dei portavoce:</b><br>
                        I portavoce sono 4. Il primo è situato sulla parte fissa dello strumento, nella parte
                        iniziale della prima curva a partire dall’imboccatura; gli altri tre sono sulla prima
                        metà della coulisse, due sul tubo sinistro e l’ultimo sul tubo destro. Essi consentono
                        l’esecuzione delle dodicesime e delle diciassettesime (nonché di eventuali altri
                        armonici) che completano la tessitura dello strumento.<br>
                        L’azionamento dei portavoce avviene mediante 4 chiavi collocate sull’impugnatura
                        centrale della coulisse.
                    </p>
                    <p>
                        <b>Estensione:</b><br>
                        Il sistema consente un’estensione complessiva di tubo da circa 125 a oltre 750 cm., che
                        tradotto in termini di frequenza significa:<br>
                        1) Nell’ambito dei soli suoni fondamentali: 2 ottave e una quinta giusta, ossia da FA-1
                        (hz. 10.92) a DO 1 (hz. 65.4).<br>
                        <Image class="score" src={scores['estensione-fondamentali.webp']}
                               alt="Suoni fondamentali: da FA−1 a DO1" loading="lazy"/>
                        2) Mentre con l’utilizzo degli armonici, l’estensione totale dello strumento è di 5
                        ottave complete: da FA-1 (hz. 10.92) a FA 4 (hz. 349.2). Altri armonici superiori, spesso
                        facilmente ottenibili, arricchiscono l’ambito delle frequenze e il timbro dello
                        strumento.<br>
                        <Image class="score" src={scores['estensione-armonici.webp']}
                               alt="Estensione con armonici: da FA−1 a FA4" loading="lazy"/>
                    </p>
                </div>
                <div class="body-copy" data-language="en" lang="en" hidden>
                    <p>
                        <b>Valves and bells:</b><br>
                        Three rotary valves divide the tube into four different length ranges, that is
                        frequency. Two different central valves shorten the way of the sounds-wave, while
                        a final third valve, that leads to a secondary tube, extends it.
                        The first two valves, each bringing to a different bell, divide the tube at about the
                        middle of its length and they are put in the middle of the double slide. A small bell
                        comes out directly from the port of valve 1, a secondary tube, with a larger bell,
                        comes out from valve 2. The normal position, that follows these first two positions,
                        is the main tubing and its passage way along the double slide that leads to the last
                        large bell. Valve 3, placed before the last bell, arrives at a long secondary tube that
                        comes out in the above mentioned bell. The secondary tubes and the final part of
                        the main tube that precedes the last bell, are provided with a tuning slide.<br>
                        Three touchpieces driven by left hand allow the movement.
                    </p>
                    <p>
                        <b>Positions:</b><br>
                        Therefore the instrument has 4 firm positions and each of them permit a certain
                        number of chromatic excursions of the slide:<br>
                        Valve 1 : 10 positions.<br>
                        Valve 2 : 6 positions.<br>
                        Normal : 8 positions.<br>
                        Valve 3 : 6 positions, plus 3 positions with chromatic pitch pump.
                    </p>
                    <p>
                        <b>Speaker keys system:</b><br>
                        The speaker keys are 4. The first is located on the firm portion of the instrument, at
                        the beginning of the first bend starting from the embouchure; the other three speaker
                        keys are on the first half of the slide, two on the left tube and the last one on the right
                        tube. They allow the twelfths (and possible other harmonics) that complete the
                        playing range.
                    </p>
                    <p>
                        <b>Range:</b><br>
                        The system permits a total extension of the tube from 125 to over 750 cm. In
                        terms of frequency it means:<br>
                        1) Talking about the only fundamental tones: 2 octaves and a perfect fifth, that is
                        from FA-1 (hz. 10.92) to C 1 (hz. 65.4).<br>
                        <Image class="score" src={scores['range-fundamentals.webp']} alt="Fundamental tones: F−1 to C1"
                               loading="lazy"/>
                        2) By using the harmonics (12 th and 17 th ), the total range of the instrument is 5
                        complete octaves: from FA-1 (hz. 10.92) to FA 4 (hz.349.2). Other higher
                        harmonics, often obtainable, expand the frequencies range and the timbres of
                        instrument.<br>
                        <Image class="score" src={scores['range-harmonics.webp']}
                               alt="Total range with harmonics: F−1 to F4" loading="lazy"/>
                    </p>
                </div>
            </div>
        </div>
        <div class="detail-photo photo">
            <Image src={detail} widths={widths(detail)} sizes="(max-width: 48rem) 100vw, 510px"
                   alt="Dettaglio della doppia coulisse e delle chiavi dell’Ecatorf" loading="lazy" decoding="async"/>
        </div>
        <div class="video">
            <iframe src="https://www.youtube-nocookie.com/embed/IZ7kZjdvGnY?color=white"
                    title="Ecatorf a Villa Rossi, Santorso" loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </article>
    <section id="progettazione" class="design" aria-labelledby="design-title">
        <h2 id="design-title">
            <span data-language="it">Progettazione</span>
            <span data-language="en" lang="en" hidden>Design</span>
        </h2>
        <DesignCarousel pages={designPages} />
    </section>
</BaseLayout>

<script>
    const button = document.querySelector<HTMLButtonElement>('.translation');
    const sections = document.querySelectorAll<HTMLElement>('[data-language]');
    if (button) {
        button.hidden = false;
        button.addEventListener('click', () => {
            const english = button.getAttribute('aria-pressed') !== 'true';
            for (const section of sections) section.hidden = section.dataset.language !== (english ? 'en' : 'it');
            button.textContent = english ? 'Traduzione' : 'Translation';
            button.setAttribute('aria-label', english ? 'Leggi in italiano' : 'Read in English');
            button.setAttribute('aria-pressed', String(english));
            document.dispatchEvent(new CustomEvent('ecatorf:languagechange'));
        });
    }
</script>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: center;
        justify-items: center;
        height: 60vh;
        min-height: 17rem;
        max-height: 32rem;
        padding: 4rem 1rem 2rem;
        background: #061a40;
        color: white;
    }

    .hero img, .hero::after {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .hero img {
        object-fit: cover;
        z-index: -2;
    }

    .hero::after {
        content: '';
        z-index: -1;
        background: linear-gradient(rgba(6, 26, 64, 0.46), rgba(6, 26, 64, 0.68));
    }

    h2 {
        margin: 0 0 0.625rem;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .ecatorf {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: auto auto 1fr;
        grid-column-gap: 3.75rem;
        align-items: start;
        max-width: 71.25rem;
        margin: 0 auto;
        padding: 2.1875rem 1.875rem 3.125rem;
    }

    .structure {
        grid-column: 1;
        grid-row: 1;
        padding: 0 1.875rem;
    }

    .structure-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
    }

    .translation {
        flex-shrink: 0;
        border: 1px solid #c7cfda;
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        margin-left: 0.75rem;
        background: #f5f7fa;
        color: #1f344e;
        font-family: var(--font-ui);
        font-size: 0.875rem;
        line-height: 1.4;
        cursor: pointer;
    }

    .translation:hover {
        border-color: #8798ae;
        background: #eaf0f6;
    }

    .translation:active {
        background: #dfe7f0;
    }

    .translation:focus {
        outline: 2px solid #062e69;
        outline-offset: 3px;
    }

    .ecatorf p {
        text-align: justify;
    }

    .photo {
        position: relative;
        border-radius: 0.25rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .photo::before {
        content: '';
        display: block;
    }

    .photo img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .right-column {
        grid-column: 2;
        grid-row: 1 / 4;
    }

    .instrument-photo::before {
        padding-top: 65.686275%;
    }

    .detail-photo {
        grid-column: 1;
        grid-row: 2;
    }

    .detail-photo::before {
        padding-top: 117.647059%;
    }

    .technical-description {
        padding: 2.1875rem 1.875rem 0;
    }

    .score {
        margin: 0.75rem 0;
        width: 100%;
    }

    .video {
        grid-column: 1;
        grid-row: 3;
        position: relative;
        margin-top: 9.375rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .video::before {
        content: '';
        display: block;
        padding-top: 56.25%;
    }

    iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .design {
        max-width: 78.125rem;
        margin: 0 auto;
        padding: 0 1.25rem 3.75rem;
        text-align: center;
        scroll-margin-top: 5rem;
    }

    .design h2 {
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    @media (max-width: 62rem) {
        .ecatorf {
            grid-column-gap: 2rem;
        }

        .structure, .technical-description {
            padding-left: 0;
            padding-right: 0;
        }
    }

    @media (max-width: 48rem) {
        .ecatorf {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            padding: 1.25rem 1.25rem 2.5rem;
        }

        .right-column {
            display: contents;
        }

        .structure {
            order: 1;
        }

        .detail-photo {
            order: 2;
        }

        .technical-description {
            order: 3;
        }

        .video {
            order: 4;
        }

        .instrument-photo {
            display: none;
        }

        .detail-photo {
            margin-bottom: 1.5rem;
        }

        .detail-photo::before {
            padding-top: 100%;
        }

        .technical-description {
            padding-top: 0;
        }

        .video {
            margin-top: 1.5rem;
        }

        .design {
            padding-bottom: 2.5rem;
        }
    }
</style>
