---
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-inner">
        <address>
            <strong>Sergio Fedele</strong><br/>
            Via Garibaldi 21, 35042 Este (PD)<br/>
            Telefono: <a href="tel:+3904292506">0429 2506</a><br/>
            E-mail: <a href="mailto:fede-ser@hotmail.com">fede-ser@hotmail.com</a>
        </address>
        <p class="credits">
            &copy; {year} Sergio Fedele<br/>
            Sito di <a href="https://www.linkedin.com/in/radusclifos/">Radu Sclifos</a>
        </p>
    </div>
</footer>

<style>
    .site-footer {
        border-top: 1px solid #dce1e9;
        background: #f2f2f2;
        color: #061a40;
        font-size: 0.875rem;
    }

    .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        max-width: 65rem;
        margin-inline: auto;
        padding: 1.75rem 1rem;
    }

    address {
        font-style: normal;
    }

    .credits {
        margin: 0;
        text-align: right;
        font-size: 0.75rem;
    }

    a {
        color: #002364;
    }

    @media (max-width: 36rem) {
        .footer-inner {
            flex-direction: column;
        }

        .credits {
            text-align: left;
        }
    }
</style>
