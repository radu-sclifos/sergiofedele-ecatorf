---
import { Image } from 'astro:assets';
import LoadingImage from './LoadingImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    photos: { src: ImageMetadata; alt: string }[];
    layout?: 'photos' | 'covers';
    skeleton?: boolean;
}

const {photos, layout = 'photos', skeleton = true} = Astro.props;

const covers = layout === 'covers';
const widths = (src: ImageMetadata) => (covers ? [320, 480, 800, 1040, 1600, 2080] : [320, 480, 720, 960])
    .filter(width => width < src.width).concat(src.width);
const sizes = covers ? '(max-width: 71.25rem) 100vw, 1040px' : '(max-width: 36rem) 92vw, (min-width: 64rem) 28rem, 46vw';
---

<ul class:list={["photo-grid", {"cover-grid": covers}]} data-gallery>
    {photos.map(({src, alt}) => (
            <li class:list={{"square-cover": covers && src.width <= src.height}}>
                <a href={src.src} data-pswp-width={src.width} data-pswp-height={src.height}
                   data-cropped={covers ? undefined : "true"}>
                    {skeleton ?
                            <LoadingImage src={src} alt={alt} widths={widths(src)} sizes={sizes}/>
                        :
                            <Image src={src} alt={alt} loading="lazy" widths={widths(src)} sizes={sizes}/>}
                </a>
            </li>
    ))}
</ul>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import { imageZoomOptions } from '../scripts/photoswipe-options';
    import { addFullscreenTransitions } from '../scripts/photoswipe-transitions';
    import 'photoswipe/style.css';

    const lightbox = new PhotoSwipeLightbox({
        ...imageZoomOptions,
        gallery: '[data-gallery]',
        children: 'a',
        pswpModule: () => import('photoswipe'),
        closeTitle: 'Chiudi',
        zoomTitle: 'Ingrandisci',
        arrowPrevTitle: 'Fotografia precedente',
        arrowNextTitle: 'Fotografia successiva',
        errorMsg: 'Impossibile caricare la fotografia.',
    });
    addFullscreenTransitions(lightbox);
    lightbox.init();
</script>

<style>
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .photo-grid img {
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        object-fit: cover;
        border-radius: 0.25rem;
        box-shadow: 0 0.25rem 0.8rem rgba(6, 26, 64, 0.22);
    }

    .photo-grid a {
        display: block;
        position: relative;
        cursor: zoom-in;
    }

    .photo-grid:not(.cover-grid) a {
        aspect-ratio: 3 / 2;
    }

    .photo-grid:not(.cover-grid) :global(.loading-image) {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
    }

    .photo-grid:not(.cover-grid) :global(.image-frame) {
        height: 100%;
        border-radius: 0.25rem;
        box-shadow: 0 0.25rem 0.8rem rgba(6, 26, 64, 0.22);
    }

    .photo-grid:not(.cover-grid) :global(.image-frame img) {
        object-fit: cover;
    }

    .cover-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .cover-grid li {
        min-width: 0;
    }

    .cover-grid .square-cover {
        width: 100%;
        max-width: 30rem;
        margin: 0 auto;
    }

    .cover-grid a {
        border: 1px solid #d8dee7;
    }

    .cover-grid img {
        position: static;
        height: auto;
        object-fit: contain;
    }

    @media (max-width: 36rem) {
        .photo-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
