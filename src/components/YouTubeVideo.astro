---
interface Props {
    videoId: string;
    title: string;
}

const {videoId, title} = Astro.props;
---

<div class="youtube-video" data-youtube-video={videoId} data-video-title={title}>
    <div class="youtube-placeholder" data-youtube-placeholder>
        <div>
            <strong>{title}</strong>
            <p>Il video è ospitato su YouTube. Per visualizzarlo, consenti il servizio nelle preferenze cookie.</p>
            <button type="button" data-cookie-settings hidden>Preferenze cookie</button>
            <a href={`https://www.youtube.com/watch?v=${videoId}`} rel="noreferrer">Guarda su YouTube</a>
            <noscript><p>JavaScript è disattivato: puoi guardare il video direttamente su YouTube.</p></noscript>
        </div>
    </div>
</div>

<style>
    .youtube-video {
        position: relative;
        background: #f1f3f6;
        color: #1f344e;
    }

    .youtube-video::before {
        content: '';
        display: block;
        padding-top: 56.25%;
    }

    .youtube-placeholder, .youtube-video :global(iframe) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .youtube-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow-y: auto;
        border: 1px solid #c7cfda;
        text-align: center;
        font-family: var(--font-ui);
        font-size: 0.8125rem;
        line-height: 1.6;
    }

    .youtube-placeholder[hidden] {
        display: none;
    }

    .youtube-placeholder p {
        margin: 0.5rem 0 0.75rem;
    }

    .youtube-placeholder a {
        display: inline-block;
        color: #002364;
    }

    button {
        margin: 0 0.75rem 0.5rem 0;
        padding: 0.5rem 0.75rem;
        border: 1px solid #8798ae;
        border-radius: 0.25rem;
        background: #fff;
        color: #061a40;
        font: inherit;
        cursor: pointer;
    }

    button:hover {
        background: #eaf0f6;
    }

    button:focus, a:focus {
        outline: 2px solid #062e69;
        outline-offset: 3px;
    }

    @media (max-width: 26rem) {
        .youtube-video::before {
            padding-top: 75%;
        }

        .youtube-placeholder {
            font-size: 0.75rem;
            padding: 0.75rem;
        }
    }
</style>
