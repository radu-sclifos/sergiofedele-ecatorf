---
import type { ImageMetadata } from 'astro';
import ActionIcon from './ActionIcon.astro';
import ImageSkeleton from './ImageSkeleton.astro';

interface Props {
    pages: { src: ImageMetadata; alt: string }[];
    pagesPerSlide?: 1 | 2;
    label?: string;
}

const {pages, pagesPerSlide = 2, label = 'Tavole di progettazione'} = Astro.props;
const pairs = Array.from({length: Math.ceil(pages.length / pagesPerSlide)}, (_, index) => pages.slice(index * pagesPerSlide, (index + 1) * pagesPerSlide));
---

<div class:list={['design-carousel', {'single-page-carousel': pagesPerSlide === 1}]}
     data-design-carousel data-pages-per-slide={pagesPerSlide} data-page-count={pages.length} role="region"
     aria-label={label}
     aria-roledescription="carosello">
    <template data-design-arrow>
        <ActionIcon name="previous" size={32} strokeWidth={2.5} standalone class="pswp__icn"/>
    </template>
    <div class="carousel-stage">
        {pairs.map((pair, index) => (
                <button class="spread-button" data-spread type="button" hidden={index !== 0}
                        data-height={Math.max(...pair.map(page => page.src.height))}
                        data-width={pagesPerSlide === 1 ? pair[0].src.width : undefined}
                        style={pagesPerSlide === 1 ? `--frame-padding: ${pair[0].src.height / pair[0].src.width * 100}%; --frame-width: calc(${pair[0].src.width / pair[0].src.height * 100}vh - ${pair[0].src.width / pair[0].src.height * 12}rem)` : undefined}
                        aria-label={pagesPerSlide === 1 ? `Ingrandisci pagina ${index + 1}` : `Ingrandisci pagine ${index * 2 + 1}–${index * 2 + 2}`}>
                <span class:list={['spread-pages', {'single-page': pagesPerSlide === 1}]}>
                    {pair.map(({src, alt}) => (
                            <span class="carousel-page">
                                <img src={src.src} width={src.width} height={src.height} alt={alt}
                                     loading="lazy" decoding="async" draggable="false"/>
                                <ImageSkeleton/>
                            </span>
                    ))}
                </span>
                </button>
        ))}
        <button class="carousel-arrow previous" data-previous type="button" aria-label="Coppia precedente" hidden>
            <ActionIcon name="previous" size={26} strokeWidth={2.5} standalone/>
        </button>
        <button class="carousel-arrow next" data-next type="button" aria-label="Coppia successiva" hidden>
            <ActionIcon name="next" size={26} strokeWidth={2.5} standalone/>
        </button>
    </div>
    <p class="carousel-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <noscript>
        <style is:inline>.design-carousel .carousel-stage {
            display: none;
        }</style>
        <div class="static-pages">
            {pages.map(({src, alt}) => <img src={src.src} width={src.width} height={src.height} alt={alt}
                                            loading="lazy"/>)}
        </div>
    </noscript>
</div>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';

    for (const root of document.querySelectorAll<HTMLElement>('[data-design-carousel]')) {
        const spreads = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-spread]'));
        const previous = root.querySelector<HTMLButtonElement>('[data-previous]')!;
        const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
        const status = root.querySelector<HTMLElement>('[data-status]')!;
        const singlePage = root.dataset.pagesPerSlide === '1';
        const pageCount = Number(root.dataset.pageCount);
        let current = 0;
        const english = () => document.querySelector('.translation')?.getAttribute('aria-pressed') === 'true';
        const pageRange = (index: number) => singlePage ? `${index + 1}` : `${index * 2 + 1}–${Math.min(index * 2 + 2, pageCount)}`;
        const pageLabel = (index: number) => `${english() ? (singlePage ? 'Page' : 'Pages') : (singlePage ? 'Pagina' : 'Pagine')} ${pageRange(index)} ${english() ? 'of' : 'di'} ${pageCount}`;
        const previousLabel = () => english() ? (singlePage ? 'Previous page' : 'Previous pair') : (singlePage ? 'Pagina precedente' : 'Coppia precedente');
        const nextLabel = () => english() ? (singlePage ? 'Next page' : 'Next pair') : (singlePage ? 'Pagina successiva' : 'Coppia successiva');

        function showPair(index: number) {
            current = Math.max(0, Math.min(index, spreads.length - 1));
            if (singlePage) {
                root.style.setProperty('--frame-width', spreads[current].style.getPropertyValue('--frame-width'));
            }
            spreads.forEach((spread, i) => {
                spread.hidden = i !== current;
                spread.setAttribute('aria-label', `${english() ? (singlePage ? 'Enlarge page' : 'Enlarge pages') : (singlePage ? 'Ingrandisci pagina' : 'Ingrandisci pagine')} ${pageRange(i)}`);
            });
            status.textContent = pageLabel(current);
            previous.setAttribute('aria-label', previousLabel());
            next.setAttribute('aria-label', nextLabel());
            previous.disabled = current === 0;
            next.disabled = current === spreads.length - 1;
        }

        // Fullscreen preserves the same page grouping as the preview.
        const slides = spreads.map(spread => {
            // Template contents stay inert: preparing fullscreen markup must
            // not start image requests before PhotoSwipe actually opens it
            const template = document.createElement('template');
            template.innerHTML = spread.querySelector<HTMLElement>('.spread-pages')!.outerHTML;
            const content = template.content.firstElementChild as HTMLElement;
            content.classList.add('pswp__img');
            // PhotoSwipe manages loading feedback for its fullscreen content
            content.querySelectorAll('[data-image-skeleton], noscript').forEach(node => node.remove());
            for (const image of content.querySelectorAll('img')) {
                image.loading = 'eager';
            }
            const height = Number(spread.dataset.height);
            return {
                element: spread,
                html: content.outerHTML,
                width: Number(spread.dataset.width) || Math.round(height * 1040 / 660),
                height
            };
        });
        const arrowSVG = root.querySelector<HTMLTemplateElement>('[data-design-arrow]')!.innerHTML;
        const lightbox = new PhotoSwipeLightbox({
            pswpModule: () => import('photoswipe'),
            mainClass: 'design-lightbox',
            loop: false,
            showHideAnimationType: 'zoom',
            thumbSelector: '.spread-pages',
            padding: {top: 60, bottom: 24, left: 60, right: 60},
            bgOpacity: 0.8,
            bgClickAction: 'close',
            imageClickAction: 'zoom',
            tapAction: 'zoom',
            counter: false,
            returnFocus: false,
            closeTitle: 'Chiudi',
            zoomTitle: 'Ingrandisci',
            arrowPrevTitle: previousLabel(),
            arrowNextTitle: nextLabel(),
            arrowPrevSVG: arrowSVG,
            arrowNextSVG: arrowSVG,
        });
        lightbox.addFilter('isContentZoomable', () => true);
        lightbox.addFilter('useContentPlaceholder', () => true);
        // PhotoSwipe normally animates a single thumbnail. Supply the complete
        // pair as its placeholder so the same native zoom animates both pages.
        lightbox.on('contentResize', ({content}) => {
            const placeholder = content.placeholder?.element;
            if (placeholder && !placeholder.childElementCount) {
                placeholder.innerHTML = content.data.html || '';
            }
        });
        lightbox.on('contentAppend', ({content}) => content.removePlaceholder());
        const setOpeningControls = (disabled: boolean) => {
            for (const arrow of lightbox.pswp?.element?.querySelectorAll<HTMLButtonElement>('.pswp__button--arrow') || []) {
                const pswp = lightbox.pswp!;
                const atBoundary = arrow.classList.contains('pswp__button--arrow--prev')
                    ? pswp.currIndex === 0
                    : pswp.currIndex === pswp.getNumItems() - 1;
                arrow.disabled = disabled || atBoundary;
            }
        };
        lightbox.on('openingAnimationStart', () => setOpeningControls(true));
        lightbox.on('openingAnimationEnd', () => setOpeningControls(false));
        lightbox.on('uiRegister', () => {
            lightbox.pswp?.ui?.registerElement({
                name: 'design-pages',
                order: 5,
                appendTo: 'bar',
                onInit: (element, pswp) => {
                    const update = () => {
                        element.textContent = pageLabel(pswp.currIndex);
                    };
                    pswp.on('change', update);
                    update();
                },
            });
        });
        lightbox.on('change', () => {
            if (lightbox.pswp) showPair(lightbox.pswp.currIndex);
        });
        lightbox.on('destroy', () => spreads[current].focus({preventScroll: true}));
        lightbox.init();

        spreads.forEach((spread, index) => spread.addEventListener('click', () => lightbox.loadAndOpen(index, slides)));
        previous.addEventListener('click', () => showPair(current - 1));
        next.addEventListener('click', () => showPair(current + 1));
        root.addEventListener('keydown', event => {
            if (event.altKey || event.ctrlKey || event.metaKey) {
                return;
            }
            if (event.key === 'ArrowLeft') {
                showPair(current - 1);
            } else if (event.key === 'ArrowRight') {
                showPair(current + 1);
            } else if (event.key === 'Home') {
                showPair(0);
            } else if (event.key === 'End') {
                showPair(spreads.length - 1);
            } else return;
            event.preventDefault();
            if (event.target instanceof HTMLElement && event.target.matches('[data-spread]')) spreads[current].focus({preventScroll: true});
        });
        document.addEventListener('ecatorf:languagechange', () => showPair(current));
        previous.hidden = false;
        next.hidden = false;
        showPair(0);
    }
</script>

<style>
    .carousel-stage {
        --controls-space: 7rem;
        position: relative;
        width: 100%;
        max-width: calc(157.575758vh - 18.909091rem + var(--controls-space) + 2px);
        margin: 0 auto;
        padding: 0 3.5rem;
        border: 1px solid #c7cfda;
        border-radius: 5px;
        background: transparent;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .single-page-carousel .carousel-stage {
        max-width: calc(var(--frame-width, 100vw) + var(--controls-space) + 2px);
    }

    .spread-button {
        position: relative;
        width: 100%;
        max-width: calc(157.575758vh - 18.909091rem);
        margin: 0 auto;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
    }

    .spread-button:not([hidden]) {
        display: block;
    }

    .spread-button::before {
        content: '';
        display: block;
        padding-top: 63.461538%;
    }

    .single-page-carousel .spread-button {
        max-width: var(--frame-width);
    }

    .single-page-carousel .spread-button::before {
        padding-top: var(--frame-padding);
    }

    .spread-pages {
        position: absolute;
        top: 0;
        left: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: minmax(0, 1fr);
        grid-column-gap: 7.692308%;
        width: 100%;
        height: 100%;
        background: transparent;
    }

    .carousel-page {
        display: block;
        position: relative;
        min-width: 0;
        min-height: 0;
        height: 100%;
    }

    .spread-pages img {
        min-width: 0;
        min-height: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: white;
        pointer-events: none;
    }

    .spread-pages.single-page {
        grid-template-columns: minmax(0, 1fr);
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 46px;
        height: 58px;
        padding: 0;
        border: 1px solid #061a40;
        border-radius: 0.25rem;
        color: white;
        background: rgba(6, 26, 64, 0.88);
        cursor: pointer;
    }

    .carousel-arrow :global(.action-icon) {
        display: block;
        margin: auto;
    }

    .carousel-arrow:hover {
        background: #061a40;
    }

    .carousel-arrow:disabled, .carousel-arrow:disabled:hover {
        background: rgba(6, 26, 64, 0.88);
        opacity: 0.35;
        cursor: default;
    }

    .previous {
        left: 4px;
    }

    .next {
        right: 4px;
    }

    button:focus {
        outline: 2px solid #0046b9;
        outline-offset: 3px;
    }

    .carousel-status {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .static-pages img {
        max-width: 40rem;
        margin: 1rem auto;
    }

    :global(.design-lightbox .pswp__content) {
        position: relative;
    }

    /* Target the temporary surface directly: overriding PhotoSwipe's root
       variable alone depends on stylesheet loading order. */
    :global(.design-lightbox .pswp__img--placeholder) {
        background: transparent;
    }

    :global(.design-lightbox .pswp__button--arrow) {
        visibility: visible;
        width: 48px;
        height: 64px;
        margin-top: -32px;
        color: white;
        background: rgba(6, 26, 64, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 0.25rem;
    }

    :global(.design-lightbox .pswp__button--arrow:hover),
    :global(.design-lightbox .pswp__button--arrow:active),
    :global(.design-lightbox .pswp__button--arrow:focus) {
        background: #061a40;
        border: 1px solid white;
        opacity: 1;
    }

    :global(.design-lightbox .pswp__button--arrow:disabled) {
        background: rgba(6, 26, 64, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.6);
        opacity: 0.35;
        cursor: default;
    }

    :global(.design-lightbox .pswp__button--arrow--prev) {
        left: 6px;
    }

    :global(.design-lightbox .pswp__button--arrow--next) {
        right: 6px;
    }

    :global(.design-lightbox .pswp__button--arrow .pswp__icn) {
        color: white;
        width: 32px;
        height: 32px;
        left: 8px;
        right: auto;
        top: 16px;
        margin-top: 0;
    }

    :global(.design-lightbox .pswp__design-pages) {
        color: white;
        margin: 18px 16px;
        font-size: 0.9375rem;
    }

    :global(.design-lightbox button:focus) {
        outline: 2px solid white;
        outline-offset: -3px;
    }

    @media (max-width: 48rem) {
        .carousel-stage {
            --controls-space: 5.5rem;
            padding: 0 2.75rem;
        }

        .carousel-arrow {
            width: 36px;
            height: 48px;
        }

        .previous {
            left: 3px;
        }

        .next {
            right: 3px;
        }
    }

    @media (max-height: 24rem) {
        .carousel-stage, .single-page-carousel .carousel-stage {
            max-width: calc(19rem + var(--controls-space) + 2px);
        }

        .spread-button, .single-page-carousel .spread-button {
            max-width: 19rem;
        }
    }
</style>
