---
import ActionIcon from './ActionIcon.astro';
interface Props {
    overlay: boolean;
}

const {overlay} = Astro.props;

const links = [
    {label: 'Note Biografiche', href: '/biografia/'},
    {label: 'Ecatorf', href: '/ecatorf/'},
    {label: 'Composizioni e CD', href: '/composizioni/'},
    {label: 'Partiture per Ecate', href: '/partitureperecate/'},
];

const groups = [
    {
        label: 'Contar', links: [
            {label: 'Contar', href: '/altriprogetti/contar/'},
            {label: 'Film', href: '/altriprogetti/film/'},
        ]
    },
    {
        label: 'Altri progetti', links: [
            {label: 'Musica', href: '/altriprogetti/musica/'},
            {label: 'Scripturae', href: '/altriprogetti/scripturae/'},
        ]
    },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
---

<header class:list={["site-header", {"over-hero": overlay}]}>
    <nav aria-label="Navigazione principale">
        <a class="brand" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
            Sergio Fedele
        </a>
        <button class="toggle" type="button" aria-controls="site-menu" aria-expanded="false">
            <span aria-hidden="true">☰</span> Menu
        </button>
        <ul class="menu" id="site-menu">
            {links.map((link) => (
                    <li>
                        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                            {link.label}
                        </a>
                    </li>
            ))}
            {groups.map(({label, links}) => (
                    <li>
                        <details>
                            <summary>{label}</summary>
                            <ul class="submenu">
                                {links.map(({label, href}) => (
                                        <li>
                                            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                                                {label}
                                            </a>
                                        </li>
                                ))}
                            </ul>
                        </details>
                    </li>
            ))}
            <li>
                <a href="https://www.youtube.com/channel/UCGsoqMijBRT7i6pK988AK6g" aria-label="Canale YouTube">
                    <ActionIcon name="youtube" class="youtube-icon" size={20} standalone />
                </a>
            </li>
        </ul>
    </nav>
</header>

<script>
    const overlayHeader = document.querySelector('.site-header.over-hero');

    if (overlayHeader) {
        const updateHeader = () => overlayHeader.toggleAttribute('data-scrolled', window.scrollY > 0);
        updateHeader();
        window.addEventListener('scroll', updateHeader, {passive: true});
        window.addEventListener('pageshow', updateHeader);
    }

    const toggle = document.querySelector<HTMLButtonElement>('.site-header .toggle');
    const menu = document.getElementById('site-menu');

    if (toggle && menu) {
        toggle.classList.add('ready');
        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!expanded));
            if (overlayHeader) {
                overlayHeader.classList.toggle('menu-open', !expanded);
            }
        });

        const desktopHover = window.matchMedia('(min-width: 64.01rem) and (any-hover: hover)');

        for (const group of menu.querySelectorAll('details')) {
            let mouseInside = false;

            group.addEventListener('toggle', () => {
                if (group.open) {
                    for (const other of menu.querySelectorAll('details')) {
                        if (other !== group) other.open = false;
                    }
                }
            });

            group.addEventListener('pointerenter', (event) => {
                if (event.pointerType !== 'mouse' || !desktopHover.matches) {
                    return;
                }

                mouseInside = true;
                group.open = true;
            });

            group.addEventListener('pointerleave', (event) => {
                if (event.pointerType !== 'mouse' || !mouseInside) {
                    return;
                }

                mouseInside = false;
                if (!group.contains(document.activeElement)) {
                    group.open = false;
                }
            });

            group.addEventListener('focusout', (event) => {
                if (desktopHover.matches && !mouseInside && !group.contains(event.relatedTarget as Node | null)) {
                    group.open = false;
                }
            });
        }

        menu.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape') {
                return;
            }

            const group = (event.target as HTMLElement).closest('details[open]');
            if (group) {
                group.removeAttribute('open');
                group.querySelector('summary')?.focus();
            } else if (toggle.getAttribute('aria-expanded') === 'true') {
                toggle.setAttribute('aria-expanded', 'false');
                if (overlayHeader) overlayHeader.classList.remove('menu-open');
                toggle.focus();
            }
        });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #061a40;
        color: white;
    }

    .over-hero {
        position: fixed;
        left: 0;
        right: 0;
        background: transparent;
    }

    .over-hero[data-scrolled], .over-hero.menu-open {
        background: #061a40;
    }

    @media (prefers-reduced-motion: no-preference) {
        .over-hero {
            transition: background-color 180ms ease;
        }
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 75rem;
        margin-left: auto;
        margin-right: auto;
        padding: 0.65rem 1rem;
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .menu {
        display: flex;
        align-items: center;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    a, summary, .toggle {
        padding: 0.65rem 0.7rem;
        border-radius: 0.25rem;
        color: inherit;
        text-decoration: none;
    }

    .menu > li {
        margin: 0 0.1rem;
    }

    a {
        display: block;
    }

    summary {
        cursor: pointer;
    }

    .site-header :global(.youtube-icon) {
        display: block;
        width: 1.25rem;
        height: 1.25rem;
    }

    .brand {
        margin-right: 1rem;
        font-size: 0.95rem;
        text-transform: uppercase;
    }

    a:hover, summary:hover, .toggle:hover, [aria-current="page"]:not(.brand) {
        background: rgba(255, 255, 255, 0.14);
    }

    :focus {
        outline: 2px solid white;
        outline-offset: 2px;
    }

    details {
        position: relative;
    }

    .submenu {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 10rem;
        padding: 0.3rem;
        border-radius: 0.25rem;
        background: #061a40;
        box-shadow: 0 0.4rem 1rem rgba(0, 0, 0, 0.2);
    }

    .toggle {
        display: none;
        border: 1px solid currentColor;
        background: transparent;
        font: inherit;
        cursor: pointer;
    }

    @media (max-width: 64rem) {
        nav {
            flex-wrap: wrap;
        }

        .toggle.ready {
            display: block;
        }

        .toggle.ready[aria-expanded="false"] + .menu {
            display: none;
        }

        .menu {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
            max-height: 70vh;
            overflow-y: auto;
            padding: 0.2rem;
        }

        .submenu {
            position: static;
            margin-left: 1rem;
            box-shadow: none;
        }
    }
</style>
