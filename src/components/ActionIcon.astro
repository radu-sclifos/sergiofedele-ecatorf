---
interface Props {
    name: keyof typeof paths;
    size?: number;
    strokeWidth?: number;
    standalone?: boolean;
    class?: string;
}

const paths = {
    person: ['M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z', 'M4 22v-3a8 8 0 0 1 16 0v3'],
    score: ['M14 2H5v20h14V7l-5-5Z', 'M14 2v5h5', 'M13 11v6', 'M13 11l3-1', 'M13 17c0 2-4 3-4 1s4-3 4-1Z'],
    presentation: ['M4 5h16M4 10h16M4 15h11M4 20h13'],
    review: ['M21 4H3v13h5v4l5-4h8V4Z', 'M7 8h10M7 12h7'],
    cd: ['M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', 'M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z', 'M5 9a8 8 0 0 1 4-4M15 19a8 8 0 0 0 4-4'],
    language: ['M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', 'M2 12h20', 'M12 2c-5 5-5 15 0 20M12 2c5 5 5 15 0 20'],
    music: ['M9 18V5l12-2v13M9 18a3 2 0 1 1-6 0 3 2 0 1 1 6 0Zm12-2a3 2 0 1 1-6 0 3 2 0 1 1 6 0Z'],
    eye: ['M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 1 1 6 0Z'],
    book: ['M12 6v15m0-15C9 4 6 4 2 4v15c4 0 7 0 10 2 3-2 6-2 10-2V4c-4 0-7 0-10 2Z'],
    youtube: ['M5 4h14a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Zm5 4v8l6-4-6-4Z'],
    cookie: ['M21 12a9 9 0 1 1-9-9 4 4 0 0 0 4 4 4 4 0 0 0 5 5Z', 'M9 9a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z', 'M9 15a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z', 'M15 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z'],
    previous: ['M15 5 8 12 15 19'],
    next: ['M9 5 16 12 9 19'],
};
const { name, size, strokeWidth = 1.6, standalone = false, class: className } = Astro.props;
const filled = name === 'youtube';
---

<svg class:list={['action-icon', { 'action-icon-standalone': standalone }, className]}
     style={size ? `width: ${size}px; height: ${size}px;` : undefined}
     xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
     width={size ?? 18} height={size ?? 18} fill={filled ? 'currentColor' : 'none'}
     fill-rule={filled ? 'evenodd' : undefined} stroke={filled ? 'none' : 'currentColor'} stroke-width={strokeWidth}
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {paths[name].map(d => <path d={d}/>)}
</svg>
