---
import { Image } from 'astro:assets';
import ImageSkeleton from './ImageSkeleton.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    widths?: number[];
    sizes?: string;
    loading?: 'lazy' | 'eager';
}

const {src, alt, widths, sizes, loading = 'lazy'} = Astro.props;
---

<div class="loading-image" data-loading-image>
    <div class="image-frame" style={{aspectRatio: `${src.width} / ${src.height}`}}>
        <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async"/>
        <ImageSkeleton/>
    </div>
</div>

<style>
    .loading-image {
        width: 100%;
    }

    .image-frame {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .image-frame img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

</style>
